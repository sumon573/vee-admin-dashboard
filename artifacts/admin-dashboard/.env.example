# ──────────────────────────────────────────────────────────────────────────────
# Firebase – required for auth, Realtime Database, Firestore, Storage
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Values come from: Firebase Console → Project Settings → Your Apps → SDK setup

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ──────────────────────────────────────────────────────────────────────────────
# Local emulator suite (optional)
# Set to "true" to use local Firebase emulators instead of production
# ──────────────────────────────────────────────────────────────────────────────
VITE_USE_FIREBASE_EMULATORS=false
